---
// Embeds the (separately-hosted, low-priority) blog as an iframe and keeps
// it in sync with the site's own dark/light theme via a `?theme=` query
// param, per the blog's documented convention.
interface Props {
  src: string;
  title?: string;
  height?: string;
  desktopHeight?: string;
}
const { src, title = 'Blog', height = '800px', desktopHeight = height } = Astro.props;
---

<!-- Cross-origin blog embed; back/forward post messages into the frame (blog-side listener required — see docs/notes.md#blog-iframe-blogembedastro). Buttons are separately-positioned absolute elements, not a shared wrapper, to avoid them collapsing together on click. -->
<div class="blog-embed-container" style={`--blog-embed-height: ${height}; --blog-embed-desktop-height: ${desktopHeight};`}>
  <iframe
    id="blog-embed-frame"
    class="blog-embed-frame"
    data-base-src={src}
    title={title}
    loading="lazy"
  ></iframe>
  <button
    type="button"
    id="blog-embed-back"
    class="blog-embed-nav blog-embed-nav-back"
    title="Back one page in the blog"
    aria-label="Back one page in the blog"
  >‹</button>
  <button
    type="button"
    id="blog-embed-forward"
    class="blog-embed-nav blog-embed-nav-forward"
    title="Forward one page in the blog"
    aria-label="Forward one page in the blog"
  >›</button>
</div>

<script>
  // Theme comes from body.dark-mode; MutationObserver below reloads the
  // iframe (with ?theme=) whenever it changes, incl. after view transitions.
  function currentTheme() {
    return document.body.classList.contains('dark-mode') ? 'dark' : 'light';
  }

  // Blog's last-reported location, via postMessage (blog-side snippet
  // required — see docs/notes.md#blog-iframe-blogembedastro). Without it,
  // every theme toggle resets the embed to the blog's homepage instead of
  // staying on the current page.
  let currentBlogPath: string | null = null;

  function themedUrl(baseSrc: string, theme: string) {
    const target = currentBlogPath
      ? new URL(currentBlogPath, baseSrc)
      : new URL(baseSrc, window.location.origin);
    target.searchParams.set('theme', theme);
    return target.toString();
  }

  function syncFrame(frame: HTMLIFrameElement) {
    const baseSrc = frame.dataset.baseSrc;
    if (!baseSrc) return;
    const themed = themedUrl(baseSrc, currentTheme());
    if (frame.getAttribute('src') !== themed) {
      frame.setAttribute('src', themed);
    }
  }

  // Registered once at module scope (not inside initBlogFrame, which reruns
  // on every soft navigation back to this page) so it never stacks up.
  window.addEventListener('message', (event) => {
    const frame = document.getElementById('blog-embed-frame') as HTMLIFrameElement | null;
    const baseSrc = frame?.dataset.baseSrc;
    if (!baseSrc) return;
    const expectedOrigin = new URL(baseSrc, window.location.origin).origin;
    if (event.origin !== expectedOrigin) return;
    if (event.data?.type !== 'blog-nav-state') return;
    if (typeof event.data.path !== 'string') return;
    currentBlogPath = event.data.path;
  });

  let observer: MutationObserver | null = null;

  // Back/forward: cross-origin means contentWindow.history is unreachable,
  // so these postMessage into the frame — blog needs a matching listener
  // (sessionStorage-based, NOT history.back()/forward() — an iframe shares
  // the tab's joint history, so that falls through to navigating the outer
  // site once the iframe's own entries run out, confirmed live). Full
  // snippets for both required blog-side listeners are in
  // docs/notes.md#blog-iframe-blogembedastro.
  function postNav(frame: HTMLIFrameElement, action: 'back' | 'forward') {
    const baseSrc = frame.dataset.baseSrc;
    if (!baseSrc || !frame.contentWindow) return;
    const targetOrigin = new URL(baseSrc, window.location.origin).origin;
    frame.contentWindow.postMessage({ type: 'blog-nav', action }, targetOrigin);
  }

  let backClickHandler: (() => void) | null = null;
  let forwardClickHandler: (() => void) | null = null;

  function initBlogFrame() {
    const frame = document.getElementById('blog-embed-frame') as HTMLIFrameElement | null;
    if (!frame) return;

    syncFrame(frame);

    if (observer) observer.disconnect();
    observer = new MutationObserver(() => syncFrame(frame));
    observer.observe(document.body, { attributes: true, attributeFilter: ['class'] });

    const backBtn = document.getElementById('blog-embed-back');
    const forwardBtn = document.getElementById('blog-embed-forward');

    if (backBtn) {
      if (backClickHandler) backBtn.removeEventListener('click', backClickHandler);
      backClickHandler = () => postNav(frame, 'back');
      backBtn.addEventListener('click', backClickHandler);
    }

    if (forwardBtn) {
      if (forwardClickHandler) forwardBtn.removeEventListener('click', forwardClickHandler);
      forwardClickHandler = () => postNav(frame, 'forward');
      forwardBtn.addEventListener('click', forwardClickHandler);
    }
  }

  document.addEventListener('astro:page-load', initBlogFrame);
</script>

<style>
  .blog-embed-container {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border-color);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  }

  .blog-embed-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--border-color);
    background: var(--surface-color-glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--text-primary);
    font-size: 1.2rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 1;
    box-shadow: var(--card-shadow);
    transition: transform 0.2s ease, opacity 0.2s ease;
    opacity: 0.85;
  }

  .blog-embed-nav:hover {
    transform: translateY(-50%) scale(1.08);
    opacity: 1;
  }

  .blog-embed-nav-back {
    left: 0.75rem;
  }

  .blog-embed-nav-forward {
    right: 0.75rem;
  }

  .blog-embed-frame {
    display: block;
    width: 100%;
    height: var(--blog-embed-height);
    border: none;
  }

  /* Matches the nav's own mobile/desktop breakpoint (Navbar.astro) — give the
     blog more room to breathe once there's a laptop-sized viewport to use. */
  @media (min-width: 900px) {
    .blog-embed-frame {
      height: var(--blog-embed-desktop-height);
    }
  }
</style>
