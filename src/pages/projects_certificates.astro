---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getData } from '../utils/db.js';
import Card from '../components/Card.astro';
import { formatDate as formatDateShared, isFutureDate } from '../utils/format';

const { basic_info, projects, certifications } = getData({
	projects: 'SELECT * FROM projects WHERE fk_user = ?',
	certifications: 'SELECT * FROM certifications WHERE fk_user = ?',
});

const formatDate = (dateString) => formatDateShared(dateString, 'YYYY-MM-DD');
---

<BaseLayout 
    title={basic_info ? `${basic_info.name.split(" ")[0]}'s Projects & Certifications` : "Projects & Certifications"}
    current_page="projects_certificates"
>
    <!-- Heading handled by Navbar -->

    <div class="page-content">
        <section id="projects">
            <h2 class="section-title">Projects</h2>
            <div class="card-grid">
                {projects.map(proj => (
                    <Card 
                        title={proj.title} 
                        link={proj.link}
                    >
                        <p>{proj.description}</p>
                    </Card>
                ))}
            </div>
        </section>

        <section id="certifications">
            <h2 class="section-title">Certifications</h2>
            <div class="card-grid">
                {certifications.map(cert => (
                    <Card 
                        title={cert.title} 
                        subtitle={`Issued by ${cert.issuer}`}
                        date={cert.link ? `${formatDate(cert.achievement_date)}${isFutureDate(cert.achievement_date) ? ' (exp)' : ''}` : undefined}
                        link={cert.link}
                    >
                        <p>{cert.description}</p>
                    </Card>
                ))}
            </div>
        </section>
    </div>
</BaseLayout>

<style>
    .card-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
    }

    @media (min-width: 768px) {
        .card-grid {
            grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        }
    }
</style>
