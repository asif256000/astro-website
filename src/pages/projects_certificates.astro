---
import BaseLayout from '../layouts/BaseLayout.astro';
import db from '../utils/db.js';
import Card from '../components/Card.astro';

// Query data
let basic_info = null;
let projects = [];
let certifications = [];

if (db) {
	try {
		basic_info = db.prepare('SELECT * FROM basic_info WHERE id = 1').get();
		const user_filter = basic_info ? basic_info.id : 1;

		projects = db.prepare('SELECT * FROM projects WHERE fk_user = ?').all(user_filter);
		certifications = db.prepare('SELECT * FROM certifications WHERE fk_user = ?').all(user_filter);
	} catch (error) {
		console.error('Database query failed:', error.message);
	}
}

const formatDate = (dateString, format = 'YYYY-MM-DD') => {
    if (!dateString) return '';
    const d = new Date(dateString);
    if (isNaN(d)) return dateString;
    const year = d.getUTCFullYear();
    const month = String(d.getUTCMonth() + 1).padStart(2, '0');
    const day = String(d.getUTCDate()).padStart(2, '0');
    
    return `${year}-${month}-${day}`;
};

const isFutureDate = (dateString) => {
    if (!dateString) return false;
    const d = new Date(dateString);
    return !isNaN(d) && d > new Date();
};
---

<BaseLayout 
    title={basic_info ? `${basic_info.name.split(" ")[0]}'s Projects & Certifications` : "Projects & Certifications"}
    current_page="projects_certificates"
>
    <!-- Heading handled by Navbar -->

    <div class="page-content">
        <section id="projects">
            <h2 class="section-title">Projects</h2>
            <div class="card-grid">
                {projects.map(proj => (
                    <Card 
                        title={proj.title} 
                        link={proj.link}
                    >
                        <p>{proj.description}</p>
                    </Card>
                ))}
            </div>
        </section>

        <section id="certifications">
            <h2 class="section-title">Certifications</h2>
            <div class="card-grid">
                {certifications.map(cert => (
                    <Card 
                        title={cert.title} 
                        subtitle={`Issued by ${cert.issuer}`}
                        date={cert.link ? `${formatDate(cert.achievement_date)}${isFutureDate(cert.achievement_date) ? ' (exp)' : ''}` : undefined}
                        link={cert.link}
                    >
                        <p>{cert.description}</p>
                    </Card>
                ))}
            </div>
        </section>
    </div>
</BaseLayout>

<style>
    .page-content {
        display: flex;
        flex-direction: column;
        gap: 4rem;
    }

    .section-title {
        font-size: 2.25rem;
        margin-bottom: 2rem;
        font-weight: 800;
        display: inline-block;
        background: linear-gradient(135deg, var(--text-primary), var(--text-secondary));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .card-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
    }

    @media (min-width: 768px) {
        .card-grid {
            grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        }
    }
</style>
