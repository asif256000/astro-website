---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogEmbed from '../components/BlogEmbed.astro';
import { getData } from '../utils/db.js';

const { basic_info, resume } = getData({
	resume: 'SELECT * FROM resume WHERE fk_user = ? AND is_latest = 1',
});

const resume_path = resume.length > 0 ? resume[0].file_path : '';

const BLOG_URL = 'https://blog.perch-iguana.ts.net';
---

<BaseLayout
    title={basic_info ? `${basic_info.name.split(" ")[0]}'s Resume & Blog` : "Resume & Blog"}
    current_page="resume"
>
    <!-- Heading handled by Navbar -->

    <div class="page-content">
        <section id="resume" class="glass-panel" style="padding: 2rem;">
            <div class="resume-header">
                <h2 class="section-title" style="margin-bottom: 1rem;">Resume</h2>
                <p class="resume-desc">
                    If you are looking for a resume for a specific role, please let me know via email or phone. I can tailor 
                    the resume for the role with my existing skills and experience, mentioning the relevant technologies, and send it to you.
                </p>
                {resume_path && (
                    <div style="margin-top: 1.5rem; margin-bottom: 2rem;">
                        <a href={`/${resume_path}`} download class="btn primary">
                            <span class="icon">⬇</span> Download Resume
                        </a>
                    </div>
                )}
            </div>
            
            {resume_path && (
                <div class="pdf-container">
                    <object data={`/${resume_path}`} type="application/pdf" width="100%" height="800px">
                        <embed src={`/${resume_path}`} type="application/pdf" />
                    </object>
                </div>
            )}
        </section>

        <section id="blog" class="glass-panel" style="padding: 2rem; margin-top: 2rem;">
            <h2 class="section-title" style="margin-bottom: 1rem;">Blog</h2>
            <p class="resume-desc">
                Occasional write-ups and notes, hosted separately from the rest of this site.
            </p>
            <div style="margin-top: 1.5rem;">
                <BlogEmbed src={BLOG_URL} title="Blog" height="700px" desktopHeight="1000px" />
            </div>
        </section>
    </div>
</BaseLayout>

<style>
    .resume-desc {
        color: var(--text-secondary);
        font-size: 1.1rem;
        line-height: 1.6;
        max-width: 800px;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        justify-content: center;
        padding: 0.8rem 2rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 1.1rem;
        transition: all 0.2s ease;
        background-color: var(--accent-color);
        color: #fff;
    }

    .btn:hover {
        background-color: var(--accent-hover);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
    }

    .pdf-container {
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid var(--border-color);
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }
</style>
