---
import BaseLayout from '../layouts/BaseLayout.astro';
import db from '../utils/db.js';
import Card from '../components/Card.astro';

// Query data
let basic_info = null;
let honors_and_awards = [];
let interests = [];

if (db) {
	try {
		basic_info = db.prepare('SELECT * FROM basic_info WHERE id = 1').get();
		const user_filter = basic_info ? basic_info.id : 1;

		honors_and_awards = db.prepare('SELECT * FROM honors_and_awards WHERE fk_user = ?').all(user_filter);
		interests = db.prepare('SELECT * FROM interests WHERE fk_user = ?').all(user_filter);
	} catch (error) {
		console.error('Database query failed:', error.message);
	}
}

// Helper to sort interests
const arrangeInterests = (all) => {
    const arranged = {};
    for (const i of all) {
        if (!arranged[i.subcategory]) arranged[i.subcategory] = [];
        arranged[i.subcategory].push(i.interest);
    }
    return arranged;
};

const arranged_interests = arrangeInterests(interests);
---

<BaseLayout 
    title={basic_info ? `${basic_info.name.split(" ")[0]}'s Awards & Interests` : "Awards & Interests"}
    current_page="awards_interests"
>
    <!-- Heading handled by Navbar -->

    <div class="page-content">
        <section id="honors_and_awards">
            <h2 class="section-title">Honors and Awards</h2>
            <div class="card-grid">
                {honors_and_awards.map(hna => (
                    <Card title={hna.title}>
                        <p>{hna.description}</p>
                    </Card>
                ))}
            </div>
        </section>

        <section id="interests">
            <h2 class="section-title">Interests</h2>
            <div class="card-grid">
                {Object.entries(arranged_interests).map(([int_subcategory, ints]) => {
                    const cat_ints = ints.join(", ");
                    return (
                        <Card title={int_subcategory}>
                            <p>{cat_ints}</p>
                        </Card>
                    );
                })}
            </div>
        </section>
    </div>
</BaseLayout>

<style>
    .page-content {
        display: flex;
        flex-direction: column;
        gap: 4rem;
    }

    .section-title {
        font-size: 2.25rem;
        margin-bottom: 2rem;
        font-weight: 800;
        display: inline-block;
        background: linear-gradient(135deg, var(--text-primary), var(--text-secondary));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .card-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
    }

    @media (min-width: 768px) {
        .card-grid {
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        }
    }
</style>
