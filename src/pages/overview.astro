---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import db from '../utils/db.js';
import Card from '../components/Card.astro';
import SkillSection from '../components/SkillSection.astro';

// Build-time logo map: Astro optimises every PNG in src/assets/logos/
const logoMap = import.meta.glob<{ default: ImageMetadata }>('../assets/logos/*.png', { eager: true });
const getLogo = (name: string): ImageMetadata | null =>
    logoMap[`../assets/logos/${name}.png`]?.default ?? null;

// Proportionally scale any logo to fit inside a square box.
const logoFitProps = (meta: ImageMetadata, box: number) =>
    meta.width >= meta.height ? { width: box } : { height: box };

// Query data
let basic_info = null;
let education = [];
let experience = [];
let skills = [];
let projects = [];
let certifications = [];
let honors_and_awards = [];
let interests = [];
let resume = [];

if (db) {
	try {
		basic_info = db.prepare('SELECT * FROM basic_info WHERE id = 1').get();
		const user_filter = basic_info ? basic_info.id : 1;

		education = db.prepare('SELECT * FROM education WHERE fk_user = ?').all(user_filter);
		experience = db.prepare('SELECT * FROM experience WHERE fk_user = ?').all(user_filter);
		skills = db.prepare('SELECT * FROM skills WHERE fk_user = ?').all(user_filter);
		projects = db.prepare('SELECT * FROM projects WHERE fk_user = ?').all(user_filter);
		certifications = db.prepare('SELECT * FROM certifications WHERE fk_user = ?').all(user_filter);
		honors_and_awards = db.prepare('SELECT * FROM honors_and_awards WHERE fk_user = ?').all(user_filter);
		interests = db.prepare('SELECT * FROM interests WHERE fk_user = ?').all(user_filter);
		resume = db.prepare('SELECT * FROM resume WHERE fk_user = ? AND is_latest = 1').all(user_filter);
	} catch (error) {
		console.error('Database query failed:', error.message);
	}
}

// Helpers
const arrangeSkills = (all) => {
    const arranged = {};
    for (const s of all) {
        if (!arranged[s.subcategory]) arranged[s.subcategory] = {};
        if (!arranged[s.subcategory][s.proficiency]) arranged[s.subcategory][s.proficiency] = [];
        arranged[s.subcategory][s.proficiency].push(s.skill);
    }
    return arranged;
};

const arrangeInterests = (all) => {
    const arranged = {};
    for (const i of all) {
        if (!arranged[i.subcategory]) arranged[i.subcategory] = [];
        arranged[i.subcategory].push(i.interest);
    }
    return arranged;
};

const arranged_skills = arrangeSkills(skills);
const arranged_interests = arrangeInterests(interests);

const formatDate = (dateString, format = 'YYYY-MM') => {
    if (!dateString) return '';
    const d = new Date(dateString);
    if (isNaN(d)) return dateString;
    const year = d.getUTCFullYear();
    const month = String(d.getUTCMonth() + 1).padStart(2, '0');
    const bMonth = d.toLocaleString('default', { month: 'short' });
    
    if (format === 'YYYY-MM') return `${year}-${month}`;
    if (format === 'YYYY-MMM') return `${year}-${bMonth}`;
    return `${year}-${month}`;
};

const isFutureDate = (dateString) => {
    if (!dateString) return false;
    const d = new Date(dateString);
    return !isNaN(d) && d > new Date();
};

const curr_date = new Date().toISOString().slice(0, 7);
const resume_path = resume.length > 0 ? resume[0].file_path : '';

// Merge and sort timeline events descending by date
const timeline_events = [
    ...education.map(e => ({ ...e, event_type: 'education', sort_date: new Date(e.duration_start).getTime() })),
    ...experience.map(e => ({ ...e, event_type: 'experience', sort_date: new Date(e.duration_start).getTime() }))
].sort((a, b) => b.sort_date - a.sort_date);
---

<BaseLayout 
    title={basic_info ? `${basic_info.name.split(" ")[0]}'s Overview` : "Overview"}
    current_page="overview"
>
    <!-- Extra head elements -->
    <Fragment slot="head">
        <link href="/timeline.css" rel="stylesheet">
    </Fragment>

    <Fragment slot="scripts">
        <!-- timeline.js dependency removed for native CSS timeline upgrade -->
    </Fragment>

    <div class="page-content">
        <section id="intro" class="glass-panel" style="padding: 2rem;">
            <p style="font-size: 1.1rem; line-height: 1.6;">Hi, I am <strong>{basic_info?.name}</strong>, currently residing in {basic_info?.location}.
            <br><br>
            You can reach me at <a href={`mailto:${basic_info?.email}`}>{basic_info?.email}</a> or <a href={`tel:${basic_info?.phone}`}>{basic_info?.phone}</a> ,
            or check out my <a href={basic_info?.linkedin}>LinkedIn</a> or <a href={basic_info?.github}>GitHub</a> profiles.</p>
        </section>

        <section id="timeline">
            <h2 class="section-title">My Timeline</h2>
            
            <div class="timeline-container">
                {timeline_events.map(event => (
                    <div class={`timeline-item ${event.event_type}`}>
                        <div class="timeline-dot"></div>
                        <div class="timeline-content glass-panel">
                            <span class="timeline-date">
                                {formatDate(event.duration_start, 'YYYY-MM')}{isFutureDate(event.duration_start) ? ' (exp)' : ''} &mdash; {event.duration_end ? `${formatDate(event.duration_end, 'YYYY-MM')}${isFutureDate(event.duration_end) ? ' (exp)' : ''}` : 'Present'}
                            </span>
                            
                            <h3 class="timeline-title">
                                {event.event_type === 'education' ? event.degree : event.title}
                            </h3>
                            <p class="timeline-subtitle">
                                {event.event_type === 'education' ? event.institution : event.company}
                                {event.event_type === 'education' && event.major ? ` • ${event.major}` : ''}
                            </p>
                            
                            <div class="timeline-body">
                                <div class="timeline-details">
                                    <p><strong>Location:</strong> {event.location}</p>
                                    
                                    {event.event_type === 'education' ? (
                                        <p><strong>{(!event.duration_end || new Date(event.duration_end) > new Date()) ? "Grade so far" : "Final grade"}:</strong> {event.gpa}</p>
                                    ) : (
                                        event.tech_stack && <p style="margin-top: 0.5rem;"><strong>Tech stack:</strong> {event.tech_stack}</p>
                                    )}
                                </div>
                                
                                {((event.event_type === 'education' && event.institution_logo) || (event.event_type === 'experience' && event.company_logo)) && (() => {
                                    const logoName = event.event_type === 'education' ? event.institution_logo : event.company_logo;
                                    const logoSrc = getLogo(logoName);
                                    if (!logoSrc) return null;
                                    return (
                                        <a href={event.event_type === 'education' ? event.institution_link : event.company_link} class="timeline-logo-link" target="_blank" rel="noopener">
                                            <Image
                                                src={logoSrc}
                                                alt={event.event_type === 'education' ? event.institution : event.company}
                                                {...logoFitProps(logoSrc, 80)}
                                                fetchpriority="low"
                                                loading="lazy"
                                            />
                                        </a>
                                    );
                                })()}
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </section>

        <section id="skills">
            <h2 class="section-title">Proficient Skills</h2>
            <SkillSection skillsDictionary={arranged_skills} />
        </section>

        <section id="projects">
            <h2 class="section-title">Projects</h2>
            <div class="grid-list">
                {projects.map(proj => (
                    <Card title={proj.title} link={proj.link || "/projects_certificates"} />
                ))}
            </div>
        </section>

        <section id="certifications">
            <h2 class="section-title">Certifications</h2>
            <div class="grid-list">
                {certifications.map(cert => (
                    <Card title={cert.title} subtitle={`Issued by ${cert.issuer}`}>
                        {cert.link ? (
                            <p><a href={cert.link}>View Certificate</a> received on <b>{formatDate(cert.achievement_date, 'YYYY-MMM')}{isFutureDate(cert.achievement_date) ? ' (exp)' : ''}</b></p>
                        ) : cert.achievement_date ? (
                            <p>Received on <b>{formatDate(cert.achievement_date, 'YYYY-MMM')}{isFutureDate(cert.achievement_date) ? ' (exp)' : ''}</b></p>
                        ) : null}
                    </Card>
                ))}
            </div>
        </section>

        <section id="honors_and_awards">
            <h2 class="section-title">Honors and Awards</h2>
            <div class="grid-list">
                {honors_and_awards.map(hna => (
                    <Card title={hna.title}>
                        <p>{hna.description}</p>
                    </Card>
                ))}
            </div>
        </section>

        <section id="interests">
            <h2 class="section-title">Interests</h2>
            <div class="grid-list">
                {Object.entries(arranged_interests).map(([int_subcategory, ints]) => (
                    <Card title={int_subcategory}>
                        <p>{ints.join(", ")}</p>
                    </Card>
                ))}
            </div>
        </section>

        {resume_path && (
            <section style="display: flex; justify-content: center; margin-top: 2rem;">
                <a href={`/${resume_path}`} download class="btn primary">
                    <span class="icon">⬇</span> Download Full Resume
                </a>
            </section>
        )}
    </div>
</BaseLayout>

<style>
    .page-content {
        display: flex;
        flex-direction: column;
        gap: 4rem;
    }

    .section-title {
        font-size: 2.25rem;
        margin-bottom: 2rem;
        font-weight: 800;
        display: inline-block;
        background: linear-gradient(135deg, var(--text-primary), var(--text-secondary));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .grid-list {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }

    @media (min-width: 768px) {
        .grid-list {
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        }
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        justify-content: center;
        padding: 0.8rem 2rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 1.1rem;
        transition: all 0.2s ease;
        background-color: var(--accent-color);
        color: #fff;
    }

    .btn:hover {
        background-color: var(--accent-hover);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
    }
</style>
