---
import BaseLayout from '../layouts/BaseLayout.astro';
import db from '../utils/db.js';
import Hero from '../components/Hero.astro';
import SkillSection from '../components/SkillSection.astro';

// Query data
let basic_info = null;
let skills = [];
let resume = [];

if (db) {
	try {
		basic_info = db.prepare('SELECT * FROM basic_info WHERE id = 1').get();
		const user_filter = basic_info ? basic_info.id : 1;
		skills = db.prepare('SELECT * FROM skills WHERE fk_user = ?').all(user_filter);
        resume = db.prepare('SELECT * FROM resume WHERE fk_user = ? AND is_latest = 1').all(user_filter);
	} catch (error) {
		console.error('Database query failed. Ensure profile.db has the correct schema.', error.message);
	}
}

// Helper to arrange skills
const arranged_skills = {};
for (const skill of skills) {
	if (!arranged_skills[skill.subcategory]) {
		arranged_skills[skill.subcategory] = { [skill.proficiency]: [skill.skill] };
	} else {
		if (!arranged_skills[skill.subcategory][skill.proficiency]) {
			arranged_skills[skill.subcategory][skill.proficiency] = [skill.skill];
		} else {
			arranged_skills[skill.subcategory][skill.proficiency].push(skill.skill);
		}
	}
}

const resume_path = resume.length > 0 ? resume[0].file_path : '';
---

<BaseLayout 
    title={basic_info ? `${basic_info.name.split(" ")[0]}'s Profile` : "Profile"}
    current_page="home"
>
    <!-- We no longer need the explicit heading slot as it's handled in Navbar now! -->

    <div class="page-content">
        <!-- Hero Section -->
        <section id="intro">
            {basic_info && (
                <Hero 
                    name={basic_info.name}
                    location={basic_info.location}
                    email={basic_info.email}
                    phone={basic_info.phone}
                    github={basic_info.github}
                    linkedin={basic_info.linkedin}
                    introHtml={basic_info.intro}
                />
            )}
        </section>

        <!-- Skills Section -->
        <section id="skills" class="section-block">
            <h2 class="section-title">Technical Skills</h2>
            <SkillSection skillsDictionary={arranged_skills} />
        </section>
        
        <!-- Resume Section -->
        <section id="resume" class="section-block">
            <h2 class="section-title">Resume</h2>
            {resume_path && (
                <div class="resume-wrapper glass-panel">
                    <div class="resume-header">
                        <p>Preview my latest resume below, or download a copy for your records.</p>
                        <a href={`/${resume_path}`} download class="btn primary">
                            <span class="icon">⬇</span> Download PDF
                        </a>
                    </div>
                    <div class="pdf-container">
                        <object data={`/${resume_path}`} type="application/pdf" width="100%" height="800px">
                            <embed src={`/${resume_path}`} type="application/pdf" />
                        </object>
                    </div>
                </div>
            )}
        </section>
    </div>
</BaseLayout>

<style>
    .page-content {
        display: flex;
        flex-direction: column;
        gap: 4rem;
    }

    .section-block {
        scroll-margin-top: 100px; /* offset for fixed navbar */
    }

    .section-title {
        font-size: 2.25rem;
        margin-bottom: 2rem;
        font-weight: 800;
        display: inline-block;
        background: linear-gradient(135deg, var(--text-primary), var(--text-secondary));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .resume-wrapper {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .resume-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .resume-header p {
        color: var(--text-secondary);
        font-weight: 500;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        justify-content: center;
        padding: 0.6rem 1.25rem;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.2s ease;
        background-color: var(--accent-color);
        color: #fff;
    }

    .btn:hover {
        background-color: var(--accent-hover);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
    }

    .pdf-container {
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid var(--border-color);
    }
</style>
