# Cloudflare Pages headers.
# Rules are matched most-specific-first; the /* block supplies defaults.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

/*
  # Don't let browsers second-guess our declared Content-Types.
  X-Content-Type-Options: nosniff
  # Send the origin (not the full path) to third parties; full path same-origin.
  Referrer-Policy: strict-origin-when-cross-origin
  # Nothing here needs these; deny by default.
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  # The site is framed nowhere, but it DOES frame the blog, so this only
  # restricts who may frame us.
  X-Frame-Options: SAMEORIGIN

# Astro fingerprints everything under /_astro/, so it is safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Crawler-facing text files: short cache so edits go live quickly.
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap-index.xml
  Cache-Control: public, max-age=3600

/sitemap-0.xml
  Cache-Control: public, max-age=3600
